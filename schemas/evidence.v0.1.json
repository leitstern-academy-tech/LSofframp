{
  "$defs": {
    "IssueRecord": {
      "additionalProperties": false,
      "description": "A problem met while reading the package.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "part": {
          "minLength": 1,
          "title": "Part",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "part",
        "detail"
      ],
      "title": "IssueRecord",
      "type": "object"
    },
    "ItemResult": {
      "additionalProperties": false,
      "description": "State of one item of a process; ``object_ids`` lists the objects that decided it.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "matched": {
          "default": 0,
          "minimum": 0,
          "title": "Matched",
          "type": "integer"
        },
        "object_ids": {
          "items": {
            "pattern": "^obj_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        }
      },
      "required": [
        "label",
        "state",
        "reason"
      ],
      "title": "ItemResult",
      "type": "object"
    },
    "ItemState": {
      "enum": [
        "usable",
        "needs_conversion",
        "not_usable",
        "unknown"
      ],
      "title": "ItemState",
      "type": "string"
    },
    "ProcessEvidence": {
      "additionalProperties": false,
      "description": "Outcome of the process check; never contains roster or process file content.",
      "properties": {
        "definition_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "roster": {
          "anyOf": [
            {
              "$ref": "#/$defs/RosterInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ProcessResult"
          },
          "minItems": 1,
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "definition_sha256",
        "results"
      ],
      "title": "ProcessEvidence",
      "type": "object"
    },
    "ProcessResult": {
      "additionalProperties": false,
      "description": "A process with its items; the state is the least favourable item state.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemResult"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "name",
        "state",
        "items"
      ],
      "title": "ProcessResult",
      "type": "object"
    },
    "RosterInfo": {
      "additionalProperties": false,
      "description": "What may be recorded about a roster: its fingerprint, size and date.",
      "properties": {
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "row_count",
        "as_of"
      ],
      "title": "RosterInfo",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": false,
      "description": "Outcome of one rule; ``object_ids`` lists the objects that decided it.",
      "properties": {
        "rule_id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RuleStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "object_ids": {
          "items": {
            "pattern": "^obj_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Object Ids",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "status",
        "summary"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "RuleStatus": {
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "cannot_determine"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "read_issues": {
      "items": {
        "$ref": "#/$defs/IssueRecord"
      },
      "title": "Read Issues",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/RuleResult"
      },
      "title": "Results",
      "type": "array"
    },
    "processes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "generated_at",
    "tool",
    "manifest_digest"
  ],
  "title": "LSofframp Exit Evidence Pack",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
